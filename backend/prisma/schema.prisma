generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  employee
}

enum ActorType {
  admin
  employee
  customer
  system
}

enum RequestedByType {
  admin
  employee
  customer
}

model Company {
  id              String             @id @default(uuid()) @db.Uuid
  name            String             @db.VarChar(150)
  defaultCurrency String             @default("USD") @map("default_currency") @db.VarChar(3)
  locale          String             @default("tr-TR") @db.VarChar(10)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  users           User[]
  customers       Customer[]
  productMemories ProductMemory[]
  deliveries      Delivery[]
  payments        Payment[]
  auditLogs       AuditLog[]
  reportRequests  ReportRequestLog[]

  @@map("companies")
}

model User {
  id                  String              @id @default(uuid()) @db.Uuid
  companyId           String              @map("company_id") @db.Uuid
  fullName            String              @map("full_name") @db.VarChar(150)
  username            String              @db.VarChar(100)
  passwordHash        String              @map("password_hash")
  role                UserRole
  isActive            Boolean             @default(true) @map("is_active")
  lastLoginAt         DateTime?           @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeePermission  EmployeePermission?
  deliveriesCreated   Delivery[]
  paymentsEntered     Payment[]
  productMemoriesMade ProductMemory[]

  @@unique([companyId, username])
  @@map("users")
}

model EmployeePermission {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  canViewCustomers    Boolean  @default(true) @map("can_view_customers")
  canCreateCustomers  Boolean  @default(false) @map("can_create_customers")
  canCreateDeliveries Boolean  @default(true) @map("can_create_deliveries")
  canEditDeliveries   Boolean  @default(false) @map("can_edit_deliveries")
  canCreatePayments   Boolean  @default(true) @map("can_create_payments")
  canViewReports      Boolean  @default(true) @map("can_view_reports")
  canExportReports    Boolean  @default(false) @map("can_export_reports")
  canManageEmployees  Boolean  @default(false) @map("can_manage_employees")
  canManageSettings   Boolean  @default(false) @map("can_manage_settings")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_permissions")
}

model Customer {
  id                  String               @id @default(uuid()) @db.Uuid
  companyId           String               @map("company_id") @db.Uuid
  customerCode        String?              @map("customer_code") @db.VarChar(50)
  fullName            String               @map("full_name") @db.VarChar(150)
  phone               String?              @db.VarChar(50)
  email               String?              @db.VarChar(150)
  address             String?
  notes               String?
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  credential          CustomerCredential?
  deliveries          Delivery[]
  deliveryItems       DeliveryItem[]
  payments            Payment[]
  reportRequests      ReportRequestLog[]

  @@index([companyId, fullName])
  @@map("customers")
}

model CustomerCredential {
  id                 String    @id @default(uuid()) @db.Uuid
  customerId         String    @unique @map("customer_id") @db.Uuid
  username           String    @unique @db.VarChar(100)
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([username])
  @@map("customer_credentials")
}

model ProductMemory {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  normalizedKey    String    @map("normalized_key") @db.VarChar(200)
  displayName      String    @map("display_name") @db.VarChar(200)
  sizeLabel        String?   @map("size_label") @db.VarChar(100)
  defaultUnit      String?   @map("default_unit") @db.VarChar(50)
  lastUsedPriceUsd Decimal   @map("last_used_price_usd") @db.Decimal(12, 2)
  usageCount       Int       @default(0) @map("usage_count")
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdByUser    User      @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, normalizedKey])
  @@map("product_memories")
}

model Delivery {
  id               String       @id @default(uuid()) @db.Uuid
  companyId        String       @map("company_id") @db.Uuid
  customerId       String       @map("customer_id") @db.Uuid
  createdByUserId  String       @map("created_by_user_id") @db.Uuid
  transactionDate  DateTime     @map("transaction_date") @db.Date
  currencyBase     String       @default("USD") @map("currency_base") @db.VarChar(3)
  exchangeCurrency String?      @map("exchange_currency") @db.VarChar(3)
  exchangeRate     Decimal?     @map("exchange_rate") @db.Decimal(12, 4)
  exchangeNote     String?      @map("exchange_note")
  subtotalUsd      Decimal      @map("subtotal_usd") @db.Decimal(12, 2)
  note             String?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdByUser    User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  items            DeliveryItem[]

  @@index([companyId, customerId, transactionDate(sort: Desc)])
  @@map("deliveries")
}

model DeliveryItem {
  id           String   @id @default(uuid()) @db.Uuid
  deliveryId   String   @map("delivery_id") @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  productName  String   @map("product_name") @db.VarChar(200)
  productSize  String?  @map("product_size") @db.VarChar(100)
  quantity     Decimal  @db.Decimal(12, 3)
  unitPriceUsd Decimal  @map("unit_price_usd") @db.Decimal(12, 2)
  lineTotalUsd Decimal  @map("line_total_usd") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  delivery     Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, productName])
  @@map("delivery_items")
}

model Payment {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  enteredByUserId  String    @map("entered_by_user_id") @db.Uuid
  paymentDate      DateTime  @map("payment_date") @db.Date
  amountUsd        Decimal   @map("amount_usd") @db.Decimal(12, 2)
  exchangeCurrency String?   @map("exchange_currency") @db.VarChar(3)
  exchangeRate     Decimal?  @map("exchange_rate") @db.Decimal(12, 4)
  amountExchange   Decimal?  @map("amount_exchange") @db.Decimal(12, 2)
  exchangeNote     String?   @map("exchange_note")
  paymentMethod    String    @map("payment_method") @db.VarChar(50)
  referenceNo      String?   @map("reference_no") @db.VarChar(100)
  note             String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  enteredByUser    User      @relation(fields: [enteredByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, customerId, paymentDate(sort: Desc)])
  @@map("payments")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  actorType ActorType @map("actor_type")
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   @db.VarChar(100)
  entityType String  @map("entity_type") @db.VarChar(100)
  entityId  String   @map("entity_id") @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model ReportRequestLog {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  requestedByType RequestedByType @map("requested_by_type")
  requestedById   String          @map("requested_by_id") @db.Uuid
  customerId      String?         @map("customer_id") @db.Uuid
  reportType      String          @map("report_type") @db.VarChar(30)
  fromDate        DateTime        @map("from_date") @db.Date
  toDate          DateTime        @map("to_date") @db.Date
  exportFormat    String          @map("export_format") @db.VarChar(20)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("report_request_logs")
}